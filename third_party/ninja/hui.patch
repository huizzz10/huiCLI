+/// hui: per-class runtime pools.
+/// HUI_POOL_<CLASS>_JOBS=N caps how many commands of that class run at once.
+/// Edges are classified by their rule name, and explicit pool= assignments
+/// from the manifest are left untouched.
+static void SetupHuiPools(State* state) {
+  struct PoolSpec {
+    const char* env;
+    const char* name;
+    const char* rule_match;
+  };
+  static const PoolSpec kSpecs[] = {
+      {"HUI_POOL_R8_JOBS", "hui_r8", "r8"},
+      {"HUI_POOL_KOTLIN_JOBS", "hui_kotlin", "kotlin"},
+      {"HUI_POOL_JAVA_JOBS", "hui_java", "javac"},
+      {"HUI_POOL_RUST_JOBS", "hui_rust", "rust"},
+      {"HUI_POOL_LINK_JOBS", "hui_link", ".ld"},
+  };
+  std::vector<Pool*> pools;
+  std::vector<std::string> matches;
+  for (const PoolSpec& spec : kSpecs) {
+    const char* value = getenv(spec.env);
+    if (!value || !*value)
+      continue;
+    int depth = atoi(value);
+    if (depth <= 0)
+      continue;
+    Pool* pool = new Pool(spec.name, depth);
+    state->AddPool(pool);
+    pools.push_back(pool);
+    matches.push_back(spec.rule_match);
+  }
+  if (pools.empty())
+    return;
+
+  std::map<const Rule*, Pool*> rule_pools;
+  size_t assigned = 0;
+  for (Edge* edge : state->edges_) {
+    if (!edge->rule_ || edge->pool_ != &State::kDefaultPool)
+      continue;
+    std::map<const Rule*, Pool*>::iterator it = rule_pools.find(edge->rule_);
+    if (it == rule_pools.end()) {
+      const std::string& rule_name = edge->rule_->name();
+      Pool* pool = NULL;
+      for (size_t i = 0; i < pools.size(); i++) {
+        if (rule_name.find(matches[i]) != std::string::npos) {
+          pool = pools[i];
+          break;
+        }
+      }
+      it = rule_pools.insert(std::make_pair(edge->rule_, pool)).first;
+    }
+    if (it->second) {
+      edge->pool_ = it->second;
+      assigned++;
+    }
+  }
+  if (getenv("HUI_POOL_DEBUG"))
+    fprintf(stderr, "hui: per-class pools active, %zu edges assigned\n",
+            assigned);
+}
+
+/// hui: load "<milliseconds>\t<output path>" lines into |table|.
+static bool LoadDurationFile(const char* path,
+                             std::map<std::string, int64_t>* table) {
+  FILE* file = fopen(path, "re");
+  if (!file)
+    return false;
+  char* line = NULL;
+  size_t capacity = 0;
+  ssize_t length;
+  while ((length = getline(&line, &capacity, file)) >= 0) {
+    if (line[0] == '#' || line[0] == '\n')
+      continue;
+    char* end = NULL;
+    long long ms = strtoll(line, &end, 10);
+    if (end == line || ms <= 0)
+      continue;
+    while (*end == '\t' || *end == ' ')
+      ++end;
+    if (*end == '\0' || *end == '\n')
+      continue;
+    char* newline = strchr(end, '\n');
+    if (newline)
+      *newline = '\0';
+    (*table)[end] = ms;
+  }
+  free(line);
+  fclose(file);
+  return true;
+}
