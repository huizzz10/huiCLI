+void Builder::MaybeReloadParallelism() {
+  if (config_.parallelism_file.empty() || !command_runner_.get())
+    return;
+
+  int64_t now = GetTimeMillis();
+  if (now - last_parallelism_reload_millis_ < 200)
+    return;
+  last_parallelism_reload_millis_ = now;
+
+  FILE* file = fopen(config_.parallelism_file.c_str(), "re");
+  if (!file)
+    return;
+  char buf[32];
+  size_t n = fread(buf, 1, sizeof(buf) - 1, file);
+  fclose(file);
+  buf[n] = '\0';
+
+  char* end = NULL;
+  long value = strtol(buf, &end, 10);
+  if (end == buf || value < 1)
+    return;
+
+  size_t limit = (size_t)value;
+  if (limit > (size_t)config_.parallelism)
+    limit = (size_t)config_.parallelism;
+  if (limit == command_runner_->ParallelismLimit())
+    return;
+
+  command_runner_->SetParallelismLimit(limit);
+  if (config_.verbosity == BuildConfig::VERBOSE)
+    fprintf(stderr, "ninja: runtime parallelism limit = %zu\n", limit);
+}
